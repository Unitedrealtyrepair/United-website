<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Our Work | United Realty Repair</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { font-family: "Inter", Arial, sans-serif; color: #0D1B2A; background: #fff; -webkit-font-smoothing: antialiased; }

    /* ── HEADER ── */
    .hdr { background: #fff; border-bottom: 1px solid #dce3ea; position: sticky; top: 0; z-index: 100; }
    .hdr-in {
      max-width: 1200px; margin: 0 auto; padding: 0 32px;
      height: 80px; display: flex; align-items: center;
    }
    .hdr-logo { display: flex; align-items: center; flex-shrink: 0; }
    .hdr-logo img { height: 60px; width: auto; display: block; }
    .hdr-nav { display: flex; align-items: center; gap: 36px; margin-left: auto; margin-right: 36px; }
    .hdr-nav a { font-size: 13px; font-weight: 500; letter-spacing: .055em; text-transform: uppercase; color: #0D1B2A; text-decoration: none; white-space: nowrap; }
    .hdr-nav a:hover { color: #D71920; }
    .btn-red { display: inline-block; background: #D71920; color: #fff; font-family: "Barlow Condensed", sans-serif; font-size: 15px; font-weight: 700; letter-spacing: .10em; text-transform: uppercase; text-decoration: none; padding: 14px 24px; white-space: nowrap; flex-shrink: 0; transition: background .15s; }
    .btn-red:hover { background: #b5131a; }
    .hdr-toggle { display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: 4px; margin-left: auto; }
    .hdr-toggle span { display: block; width: 24px; height: 2px; background: #0A2A4A; }
    .mob-nav { display: none; flex-direction: column; background: #fff; border-top: 1px solid #dce3ea; padding: 8px 24px 24px; }
    .mob-nav a { padding: 13px 0; border-bottom: 1px solid #dce3ea; font-size: 14px; font-weight: 500; letter-spacing: .05em; text-transform: uppercase; color: #0D1B2A; text-decoration: none; display: block; }
    .mob-nav .btn-red { margin-top: 20px; text-align: center; display: block; padding: 15px; }
    .mob-nav.open { display: flex; }

    /* ── HERO ──
       Mockup: full-width hero. Image covers the right ~60%.
       Text panel is white, sits left, does NOT span full height top.
       The image starts right at the header bottom and the text floats left on white.
       Layout: position relative container; image absolute right; text absolute left on white panel.
    ── */
    .hero {
      position: relative;
      width: 100%;
      min-height: 520px;
      display: flex;
      align-items: stretch;
      overflow: hidden;
      background: #fff;
    }
    .hero-img-wrap {
      /* Image occupies the right portion, starts from right edge of text */
      position: absolute;
      top: 0; right: 0;
      width: 62%;
      height: 100%;
      z-index: 0;
    }
    .hero-img-wrap img {
      width: 100%; height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }
    /* White panel on left — sits above the image */
    .hero-text {
      position: relative;
      z-index: 1;
      width: 42%;
      background: #fff;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 60px 56px 60px 0;
      padding-left: max(32px, calc((100vw - 1200px) / 2 + 32px));
      min-height: 520px;
    }
    .hero-h1 {
      font-family: "Barlow Condensed", sans-serif;
      font-size: 52px;
      font-weight: 800;
      line-height: 1.0;
      text-transform: uppercase;
      color: #0A2A4A;
      letter-spacing: .01em;
    }
    .hero-rule { width: 50px; height: 4px; background: #D71920; margin: 20px 0 18px; flex-shrink: 0; }
    .hero-tagline {
      font-family: "Barlow Condensed", sans-serif;
      font-size: 22px; font-weight: 700; text-transform: uppercase;
      letter-spacing: .06em; color: #0D1B2A; margin-bottom: 12px;
    }
    .hero-copy { font-size: 15px; line-height: 1.75; color: #4a5f72; margin-bottom: 32px; }
    .hero-cta { align-self: flex-start; }

    /* ── SERVICES ── */
    .services { background: #fff; padding: 72px 0 80px; }
    .sec-center { text-align: center; margin-bottom: 48px; }
    /* Eyebrow: "WHAT WE DO" — small red caps with thin line rules each side */
    .eyebrow {
      display: inline-flex; align-items: center; gap: 10px;
      font-family: "Inter", sans-serif; font-size: 11px; font-weight: 600;
      letter-spacing: .18em; text-transform: uppercase; color: #D71920;
      margin-bottom: 8px;
    }
    .eyebrow::before, .eyebrow::after {
      content: ""; display: block; width: 36px; height: 1px; background: #c0cad4;
    }
    .sec-h2 {
      font-family: "Barlow Condensed", sans-serif;
      font-size: 40px; font-weight: 800; text-transform: uppercase;
      color: #0A2A4A; letter-spacing: .02em; line-height: 1.05;
    }
    /* Grid: full-width, top+bottom border, vertical dividers only */
    .svc-grid {
      display: grid; grid-template-columns: repeat(4, 1fr);
      border-top: 1px solid #dce3ea; border-bottom: 1px solid #dce3ea;
      max-width: 1200px; margin: 0 auto;
    }
    .svc-card {
      padding: 44px 28px 44px; text-align: center;
      border-right: 1px solid #dce3ea;
    }
    .svc-card:last-child { border-right: none; }
    /* Icon circle: light gray filled, ~90px */
    .svc-ico {
      width: 90px; height: 90px; border-radius: 50%;
      background: #D6E4F0;
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 22px;
    }
    .svc-ico span { font-size: 38px; line-height: 1; }
    .svc-card h3 {
      font-family: "Barlow Condensed", sans-serif;
      font-size: 14px; font-weight: 700; letter-spacing: .09em;
      text-transform: uppercase; color: #0A2A4A; margin-bottom: 12px;
    }
    .svc-card p { font-size: 14px; line-height: 1.65; color: #5a6a7a; }

    /* ── WHO WE HELP ──
       Mockup: WHITE background (not gray). Simple 4-col layout.
       Cards have NO box/border — just icon (outline circle) + title + text.
       No card background, no outer border on the grid.
    ── */
    .who { background: #fff; padding: 72px 0 80px; border-top: 1px solid #dce3ea; }
    .who-grid {
      display: grid; grid-template-columns: repeat(4, 1fr);
      gap: 0; max-width: 1200px; margin: 0 auto;
    }
    .who-card {
      padding: 36px 24px 36px; text-align: center;
      border-right: 1px solid #dce3ea;
    }
    .who-card:last-child { border-right: none; }
    /* Icon: outline circle only, no fill */
    .who-ico {
      width: 72px; height: 72px; border-radius: 50%;
      border: 2px solid #b8cfe0; background: #D6E4F0;
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 20px;
    }
    .who-ico span { font-size: 28px; line-height: 1; }
    .who-card h3 {
      font-family: "Barlow Condensed", sans-serif;
      font-size: 14px; font-weight: 700; letter-spacing: .09em;
      text-transform: uppercase; color: #0A2A4A; margin-bottom: 10px;
      line-height: 1.3;
    }
    .who-card p { font-size: 14px; line-height: 1.6; color: #5a6a7a; }

    /* ── WHY US ── */
    .why { background: #0A2A4A; padding: 72px 0 80px; }
    .why-in { max-width: 1200px; margin: 0 auto; padding: 0 32px; display: grid; grid-template-columns: 1fr 2fr; gap: 80px; align-items: start; }
    .why .eyebrow::before, .why .eyebrow::after { background: rgba(255,255,255,.2); }
    .why-lede .eyebrow { color: #D71920; margin-bottom: 12px; }
    .why-lede .sec-h2 { color: #fff; text-align: left; font-size: 38px; }
    .why-points { display: grid; grid-template-columns: repeat(3, 1fr); gap: 36px; }
    .why-pt h4 { font-family: "Barlow Condensed", sans-serif; font-size: 17px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: #fff; margin-bottom: 10px; display: flex; align-items: center; gap: 9px; }
    .why-check { width: 20px; height: 20px; background: #D71920; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .why-check svg { width: 11px; height: 11px; }
    .why-pt p { font-size: 14px; line-height: 1.7; color: rgba(255,255,255,.65); }

    /* ── ABOUT ── */
    .about { background: #fff; padding: 72px 0 80px; border-top: 1px solid #dce3ea; border-bottom: 1px solid #dce3ea; }
    .about-in { max-width: 1200px; margin: 0 auto; padding: 0 32px; display: grid; grid-template-columns: 1fr 2fr; gap: 80px; align-items: start; }
    .about-lede .eyebrow { margin-bottom: 12px; }
    .about-lede .sec-h2 { text-align: left; font-size: 36px; }
    .about-body p { font-size: 16px; line-height: 1.8; color: #3a4a5a; margin-bottom: 16px; }
    .about-body p:last-child { margin-bottom: 0; }

    @media (max-width: 960px) {
      .why-in, .about-in { grid-template-columns: 1fr; gap: 36px; }
      .why-lede .sec-h2, .about-lede .sec-h2 { font-size: 30px; }
      .why-points { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 540px) {
      .why-points { grid-template-columns: 1fr; }
    }

    /* ── FOOTER ──
       Mockup: navy bg, full width.
       Left col: small red line, big white headline, gray body text, red arrow button.
       Thin vertical white line divider.
       Right col: 3 rows — red circle icon + text.
    ── */
    .ftr { background: #0A2A4A; }
    .ftr-main {
      max-width: 1200px; margin: 0 auto; padding: 0 32px;
      display: grid; grid-template-columns: 1fr 1px 1fr;
      align-items: center; gap: 0;
      padding-top: 60px; padding-bottom: 64px;
    }
    .ftr-left { padding-right: 60px; }
    .ftr-redline { width: 36px; height: 3px; background: #D71920; margin-bottom: 18px; }
    .ftr-left h2 {
      font-family: "Barlow Condensed", sans-serif;
      font-size: 40px; font-weight: 800; text-transform: uppercase;
      color: #fff; line-height: 1.0; letter-spacing: .01em; margin-bottom: 12px;
    }
    .ftr-left p { font-size: 14px; line-height: 1.75; color: rgba(255,255,255,.62); margin-bottom: 28px; max-width: 300px; }
    .btn-ftr {
      display: inline-flex; align-items: center; gap: 10px;
      background: #D71920; color: #fff;
      font-family: "Barlow Condensed", sans-serif;
      font-size: 15px; font-weight: 700; letter-spacing: .10em; text-transform: uppercase;
      text-decoration: none; padding: 14px 26px; transition: background .15s;
    }
    .btn-ftr:hover { background: #b5131a; }
    .btn-ftr svg { width: 16px; height: 16px; flex-shrink: 0; }
    .ftr-divider { background: rgba(255,255,255,.15); align-self: stretch; }
    .ftr-right { display: flex; flex-direction: column; gap: 24px; padding-left: 60px; }
    .ftr-row { display: flex; align-items: center; gap: 18px; }
    .ftr-bubble {
      width: 44px; height: 44px; border-radius: 50%; background: #D71920;
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .ftr-bubble svg { width: 20px; height: 20px; }
    .ftr-row span, .ftr-row a { font-size: 16px; font-weight: 500; color: #fff; text-decoration: none; line-height: 1.4; }
    .ftr-row a:hover { text-decoration: underline; }
    .ftr-bar {
      border-top: 1px solid rgba(255,255,255,.10);
      max-width: 1200px; margin: 0 auto; padding: 20px 32px;
      display: flex; justify-content: space-between;
      font-size: 12px; color: rgba(255,255,255,.3);
    }

    /* ── REVIEWS ── */
    .reviews {
      background: #F4F7FA;
      padding: 72px 0 80px;
      border-top: 1px solid #dce3ea;
      border-bottom: 1px solid #dce3ea;
    }
    .reviews-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 32px;
    }
    .reviews-header {
      text-align: center;
      margin-bottom: 44px;
    }
    .reviews-sub {
      font-size: 15px;
      line-height: 1.7;
      color: #5a6a7a;
      margin: 10px auto 0;
      max-width: 480px;
    }
    .reviews-widget {
      min-height: 200px;
      width: 100%;
    }


    /* ── OUR WORK PAGE ── */
    .work-page{background:#fff;padding:78px 0 70px;border-bottom:1px solid #dce3ea}
    .work-in{max-width:1200px;margin:0 auto;padding:0 32px}
    .work-intro{text-align:center;margin-bottom:48px}
    .work-intro .sec-h2{margin-top:4px}
    .work-intro p{font-size:15px;line-height:1.7;color:#5a6a7a;margin:14px auto 0;max-width:580px}
    .work-scroll{display:flex;gap:24px;overflow-x:auto;scroll-snap-type:x mandatory;padding:4px 4px 26px;-webkit-overflow-scrolling:touch}
    .work-scroll::-webkit-scrollbar{height:8px}.work-scroll::-webkit-scrollbar-track{background:#F4F7FA}.work-scroll::-webkit-scrollbar-thumb{background:#c0cad4}
    .work-card{min-width:360px;max-width:360px;background:#fff;border:1px solid #dce3ea;scroll-snap-align:start;transition:transform .18s ease,box-shadow .18s ease}
    .work-card:hover{transform:translateY(-4px);box-shadow:0 12px 28px rgba(13,27,42,.08)}
    .work-photo{height:250px;background:#F4F7FA;border-bottom:1px solid #dce3ea;display:flex;align-items:center;justify-content:center;color:#7a8794;font-size:12px;font-weight:600;letter-spacing:.15em;text-transform:uppercase;position:relative;overflow:hidden}
    .work-slider{position:relative;height:250px;border-bottom:1px solid #dce3ea;overflow:hidden;background:#F4F7FA}
    .work-slider img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;animation:workFade 16s infinite}
    .work-slider img:nth-child(1){animation-delay:0s}.work-slider img:nth-child(2){animation-delay:4s}.work-slider img:nth-child(3){animation-delay:8s}.work-slider img:nth-child(4){animation-delay:12s}
    @keyframes workFade{0%{opacity:0}5%{opacity:1}25%{opacity:1}30%{opacity:0}100%{opacity:0}}
    .slider-dots{position:absolute;left:0;right:0;bottom:10px;display:flex;justify-content:center;gap:6px;z-index:2}
    .slider-dots span{width:7px;height:7px;border-radius:50%;background:rgba(255,255,255,.72);border:1px solid rgba(13,27,42,.25);animation:dotFade 16s infinite}
    .slider-dots span:nth-child(1){animation-delay:0s}.slider-dots span:nth-child(2){animation-delay:4s}.slider-dots span:nth-child(3){animation-delay:8s}.slider-dots span:nth-child(4){animation-delay:12s}
    @keyframes dotFade{0%{background:#D71920}25%{background:#D71920}30%{background:rgba(255,255,255,.72)}100%{background:rgba(255,255,255,.72)}}
    .work-body{padding:22px 22px 24px}.work-body h3{font-family:"Barlow Condensed",sans-serif;font-size:22px;line-height:1;font-weight:800;color:#0A2A4A;text-transform:uppercase;letter-spacing:.04em;margin-bottom:9px}
    .work-loc{font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#D71920;margin-bottom:12px}.work-body p{font-size:14px;line-height:1.65;color:#5a6a7a}
    .work-note{text-align:center;font-size:13px;color:#7a8794;margin-top:8px}
    .verified-work{background:#F4F7FA;border-top:1px solid #dce3ea;border-bottom:1px solid #dce3ea;padding:42px 0}.verified-in{max-width:1200px;margin:0 auto;padding:0 32px;display:grid;grid-template-columns:240px 1fr auto;gap:36px;align-items:center}
    .bz-bdg{width:230px;position:relative;z-index:5}.bz-bdg a{display:block;position:relative;z-index:6}.bz-bdg img{width:230px;height:auto;display:block;border:0}
    .verified-copy h2{font-family:"Barlow Condensed",sans-serif;font-size:32px;line-height:1;font-weight:800;text-transform:uppercase;color:#0A2A4A;letter-spacing:.02em;margin-bottom:10px}
    .verified-copy p{font-size:14px;line-height:1.7;color:#5a6a7a;max-width:560px}.verified-action{position:relative;z-index:10;justify-self:end}.verified-action .btn-red{position:relative;z-index:11}
    .work-cta-wrap{background:#0A2A4A;padding:0 32px 80px}.work-cta{max-width:1200px;margin:0 auto;padding:64px 32px 68px;background:#0A2A4A;display:grid;grid-template-columns:1.5fr auto;gap:36px;align-items:center;border-top:1px solid rgba(255,255,255,.12)}
    .work-cta h2{font-family:"Barlow Condensed",sans-serif;font-size:40px;font-weight:800;line-height:1;color:#fff;text-transform:uppercase;margin-bottom:10px}.work-cta p{color:rgba(255,255,255,.65);font-size:14px;line-height:1.7;max-width:480px}
    @media(max-width:960px){.work-card{min-width:320px;max-width:320px}.verified-in{grid-template-columns:1fr;text-align:center}.verified-in .bz-bdg{margin:0 auto}.verified-copy p{margin:0 auto}.verified-action{justify-self:center}.work-cta{grid-template-columns:1fr;text-align:left}}
    @media(max-width:540px){.work-page{padding:56px 0 58px}.work-in{padding:0 24px}.work-card{min-width:82vw;max-width:82vw}.work-photo,.work-slider{height:210px}.verified-work{padding:36px 0}.verified-in{padding:0 24px}.work-cta-wrap{padding:0 24px 58px}.work-cta{padding:46px 0 50px}.work-cta h2{font-size:32px}}

    /* ── RESPONSIVE ── */
    @media (max-width: 960px) {
      .hdr-nav, .hdr .btn-red { display: none; }
      .hdr-toggle { display: flex; }
      .hero { flex-direction: column; min-height: auto; }
      .hero-img-wrap { position: relative; width: 100%; height: 260px; }
      .hero-text { width: 100%; padding: 44px 24px; min-height: auto; }
      .hero-h1 { font-size: 36px; }
      .svc-grid { grid-template-columns: 1fr 1fr; }
      .svc-card:nth-child(2) { border-right: none; }
      .svc-card:nth-child(3), .svc-card:nth-child(4) { border-top: 1px solid #dce3ea; }
      .svc-card:nth-child(4) { border-right: none; }
      .who-grid { grid-template-columns: 1fr 1fr; }
      .who-card:nth-child(2) { border-right: none; }
      .who-card:nth-child(3), .who-card:nth-child(4) { border-top: 1px solid #dce3ea; }
      .who-card:nth-child(4) { border-right: none; }
      .ftr-main { grid-template-columns: 1fr; padding-top: 48px; padding-bottom: 48px; padding-left: 24px; padding-right: 24px; }
      .ftr-left { padding-right: 0; }
      .ftr-divider { display: none; }
      .ftr-right { padding-left: 0; margin-top: 40px; }
      .ftr-bar { flex-direction: column; gap: 6px; text-align: center; padding: 16px 24px; }
    }
    @media (max-width: 540px) {
      .svc-grid { grid-template-columns: 1fr; }
      .svc-card { border-right: none !important; border-top: 1px solid #dce3ea; }
      .svc-card:first-child { border-top: none; }
      .who-grid { grid-template-columns: 1fr; }
      .who-card { border-right: none !important; border-top: 1px solid #dce3ea; }
      .who-card:first-child { border-top: none; }
    }
  
    /* ── CARD SLIDER FIX ── */
    .work-card .work-slider {
      height: 250px;
      min-height: 250px;
      max-height: 250px;
      position: relative;
      overflow: hidden;
      border-bottom: 1px solid #dce3ea;
      background: #F4F7FA;
      display: block;
    }
    .work-card .work-slider img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .work-card .work-body {
      display: block;
      padding: 22px 22px 24px;
    }
    @media (max-width: 540px) {
      .work-card .work-slider {
        height: 210px;
        min-height: 210px;
        max-height: 210px;
      }
    }
</style>
</head>
<body>

<!-- HEADER -->
<header class="hdr">
  <div class="hdr-in">
    <a href="index.html" class="hdr-logo" aria-label="United Realty Repair">
      <img src="data:image/png;base64," alt="United Realty Repair" />
    </a>
    <nav class="hdr-nav">
      <a href="index.html#services">Services</a>
      <a href="index.html#who">Who We Help</a>
      <a href="index.html#why">Why Us</a>
      <a href="index.html#about">About</a>
      <a href="work.html">Our Work</a>
      <a href="javascript:void(0)" onclick="openModal()">Contact</a>
    </nav>
    <a href="javascript:void(0)" onclick="openModal()" class="btn-red" onclick="openModal()">Request Estimate</a>
    <button class="hdr-toggle" onclick="document.getElementById('mn').classList.toggle('open')" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
  <nav class="mob-nav" id="mn">
    <a href="index.html#services" onclick="document.getElementById('mn').classList.remove('open')">Services</a>
    <a href="index.html#who" onclick="document.getElementById('mn').classList.remove('open')">Who We Help</a>
    <a href="index.html#why" onclick="document.getElementById('mn').classList.remove('open')">Why Us</a>
    <a href="index.html#about" onclick="document.getElementById('mn').classList.remove('open')">About</a>
    <a href="work.html" onclick="document.getElementById('mn').classList.remove('open')">Our Work</a>
    <a href="javascript:void(0)" onclick="document.getElementById('mn').classList.remove('open');openModal()" onclick="openModal()">Contact</a>
    <a href="javascript:void(0)" class="btn-red" onclick="document.getElementById('mn').classList.remove('open');openModal()" onclick="openModal()">Request Estimate</a>
  </nav>
</header>

<!-- OUR WORK -->
<main id="our-work">
  <section class="work-page">
    <div class="work-in">
      <div class="work-intro">
