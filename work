<script>
const contactModal = document.getElementById('contactModal');
const contactForm = document.getElementById('contactForm');
const modalSuccess = document.getElementById('modalSuccess');

function openModal() {
  contactModal.classList.add('open');
  document.body.classList.add('modal-open');
  setTimeout(() => document.getElementById('cf-name').focus(), 300);
}

function closeModal() {
  contactModal.classList.remove('open');
  document.body.classList.remove('modal-open');
  setTimeout(() => {
    contactForm.reset();
    contactForm.hidden = false;
    modalSuccess.hidden = true;
    clearErrors();
    setSubmitLoading(false);
  }, 280);
}

function handleOverlayClick(e) {
  if (e.target === contactModal) closeModal();
}

document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape' && contactModal.classList.contains('open')) closeModal();
});

function clearErrors() {
  document.querySelectorAll('.field-err').forEach(el => el.classList.remove('show'));
  document.querySelectorAll('.invalid').forEach(el => el.classList.remove('invalid'));
}

function validateForm() {
  let valid = true;
  clearErrors();

  const name = document.getElementById('cf-name');
  if (!name.value.trim()) {
    name.classList.add('invalid');
    document.getElementById('err-name').classList.add('show');
    valid = false;
  }

  const email = document.getElementById('cf-email');
  const emailRx = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  if (!emailRx.test(email.value.trim())) {
    email.classList.add('invalid');
    document.getElementById('err-email').classList.add('show');
    valid = false;
  }

  const msg = document.getElementById('cf-message');
  if (!msg.value.trim()) {
    msg.classList.add('invalid');
    document.getElementById('err-message').classList.add('show');
    valid = false;
  }

  return valid;
}

function setSubmitLoading(isLoading) {
  const btn = contactForm.querySelector('.btn-submit');
  btn.disabled = isLoading;
  btn.classList.toggle('loading', isLoading);
}

contactForm.addEventListener('submit', async function(e) {
  e.preventDefault();

  if (!validateForm()) return;

  setSubmitLoading(true);

  try {
    const response = await fetch(contactForm.action, {
      method: 'POST',
      body: new FormData(contactForm),
      headers: { 'Accept': 'application/json' }
    });

    if (response.ok) {
      contactForm.hidden = true;
      modalSuccess.hidden = false;
      contactForm.reset();
    } else {
      alert('Something went wrong sending the form. Please call or text 208-803-1372, or email info@unitedrealtyrepair.com.');
    }
  } catch (error) {
    alert('Something went wrong sending the form. Please call or text 208-803-1372, or email info@unitedrealtyrepair.com.');
  } finally {
    setSubmitLoading(false);
  }
});
</script>


